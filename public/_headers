/*
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/assets/*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
